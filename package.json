{
  "name": "crash-scene-3d",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @csd/web",
    "build": "npm run build -w @csd/web",
    "preview": "npm run preview -w @csd/web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && stylelint \"apps/web/src/**/*.css\"",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:full": "E2E_FULL=1 playwright test",
    "e2e:xb": "playwright test --grep @xb",
    "check": "./check.sh",
    "verify:headers": "node scripts/verify-headers.mjs",
    "functions:build": "npx -y netlify-cli@27.9.0 functions:build --filter @csd/web --src netlify/functions --functions .netlify/functions-build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.1",
    "stylelint": "17.15.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  },
  "packageManager": "npm@11.20.0"
}
