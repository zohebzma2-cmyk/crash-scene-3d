{
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(npx tsc *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log*)",
      "Read(./**)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh *)",
      "Bash(npm publish*)",
      "Bash(netlify *)",
      "Bash(npx netlify *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(wrangler *)",
      "Bash(npx wrangler *)",
      "Bash(firebase *)",
      "Bash(npx firebase *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat *.env*)",
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-check.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
